# Guide

guide: {
  metrics: count: entity: 5
  metrics: count: path: 5
  metrics: count: method: 6

  entity: advanced: {
    path: "/meta/network-origins/2026-09/ip-ranges/webhook-subscriptions/{appId}/{subscription-id}/test": {
      rename: param: "appId": *"webhook_subscription_id"
      rename: param: "subscription-id": *"subscription_id"
      op: create: method: *POST
    }
  }

  entity: basic: {
    path: "/meta/network-origins/2026-09/ip-ranges/simple": {
      op: load: method: *GET
    }
    path: "/meta/network-origins/2026-09/ip-ranges/webhook-subscriptions/{appId}/{subscription-id}": {
      rename: param: "appId": *"app_id"
      rename: param: "subscription-id": *"subscription_id"
      op: remove: method: *DELETE
    }
  }

  entity: origins_collection_response_ip_range_no_paging: {
    path: "/meta/network-origins/2026-09/ip-ranges": {
      op: list: method: *GET
      op: list: transform: res: *("`body.results`")|top
    }
  }

  entity: origins_collection_response_webhook_subscription_no_paging: {
    path: "/meta/network-origins/2026-09/ip-ranges/webhook-subscriptions/{appId}": {
      rename: param: "appId": *"app_id"
      op: load: method: *GET
    }
  }

  entity: origins_webhook_subscription: {
    path: "/meta/network-origins/2026-09/ip-ranges/webhook-subscriptions/{appId}": {
      rename: param: "appId": *"id"
      op: create: method: *POST
    }
  }

}